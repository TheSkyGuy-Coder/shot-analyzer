{
  "name": "shot-analyzer",
  "productName": "Shot Analyzer",
  "version": "0.1.0",
  "description": "Lokales Analyse- und Planungswerkzeug für Kurzfilm-Lehre: Shots erkennen, labeln, zeichnen, auswerten.",
  "main": "./out/main/index.js",
  "author": "Shot Analyzer Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:ffmpeg": "tsx scripts/test-ffmpeg.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "test:logic": "tsx scripts/test-logic.ts",
    "test": "npm run test:logic && npm run test:ffmpeg"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
