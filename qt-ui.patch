+button:disabled{color:var(--disabled);background:var(--button);box-shadow:none}
+button:disabled .icon{opacity:.45}
+button.primary,button.on{
+  background:linear-gradient(var(--hl-hi),var(--hl-lo));border-color:#12365a;color:#fff;
+  box-shadow:inset 0 1px 0 #6aaae0
