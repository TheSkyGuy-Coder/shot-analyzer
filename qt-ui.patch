+/* Buttons */
+button,.btn{
+  font:inherit;color:var(--text);cursor:default;
+  display:inline-flex;align-items:center;gap:5px;justify-content:center;
+  min-height:22px;padding:2px 10px;
+  background:linear-gradient(var(--button-hi),var(--button-lo));
+  border:1px solid var(--outline);border-radius:2px;
+  box-shadow:inset 0 1px 0 var(--bevel)
+}
+button:hover{background:linear-gradient(#5a5a5a,#474747)}
