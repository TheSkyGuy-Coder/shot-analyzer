-.grp{display:flex;gap:6px;align-items:center;padding-left:10px;border-left:1px solid var(--line)}
-button,.btn{font:inherit;color:var(--text);background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:5px 10px;cursor:pointer}
-button:hover{border-color:var(--accent)}
